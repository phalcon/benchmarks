#!/usr/bin/env bash
# Entry point of the benchmark suite.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

# shellcheck source=scripts/lib.sh
. scripts/lib.sh
# shellcheck source=scripts/build.sh
. scripts/build.sh
# shellcheck source=scripts/run.sh
. scripts/run.sh
# shellcheck source=scripts/sweep.sh
. scripts/sweep.sh

bench_load_env

usage() {
    cat <<'EOF'
Usage: ./bench <command> [arguments]

Commands:
  build <target>     Build an image. Targets: base, tools, wrk, <variant>
  lint               Run PHP_CodeSniffer and PHPStan
  report <folder>    Make results.json and report.txt of a run folder
  run [options]      Run the benchmarks and the report. Options:
                     --variants "<names>", --repetitions <n>, --duration <s>,
                     --levels-json "<list>", --levels-plaintext "<list>",
                     --env NAME=VALUE (server), --allow-noise, --dom0-confirmed
  stop               Remove the benchmark containers
  sweep [options]    Run the php-fpm worker sweep (D6). Options:
                     --values "<list>", --repetitions <n>, --duration <s>,
                     --allow-noise, --dom0-confirmed
  test [arguments]   Run PHPUnit
  tools <command>    Run a command in the tools image
  verify <variant> [--keep] [--env NAME=VALUE]...
                     Start the server of a variant and check it
  wrk <test> <file> [--levels "<list>"] [--duration <seconds>]
                     Run the load generator against the running server
EOF
}

# Runs the load generator for one test against a server that runs already
# (for example after "verify --keep").
cmd_wrk() {
    local test="" out="" levels="" duration=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --levels) levels=$2; shift ;;
            --duration) duration=$2; shift ;;
            -*) bench_die "unknown option: $1" ;;
            *)
                if [ -z "$test" ]; then
                    test=$1
                else
                    out=$1
                fi
                ;;
        esac
        shift
    done
    if [ -z "$test" ] || [ -z "$out" ]; then
        bench_die "usage: ./bench wrk <test> <file> [--levels \"<list>\"] [--duration <seconds>]"
    fi

    # Remove only the wrk container. The server stays up.
    trap 'docker rm -f bench-wrk >/dev/null 2>&1 || true' EXIT
    trap 'exit 130' INT TERM

    mkdir -p "$(dirname "$out")"
    bench_wrk "$test" "$out" "$levels" "$duration" \
        || bench_die "wrk failed or did not run on vCPU ${WRK_CPU} (see ${out})"
}

# Starts the server of a variant, checks the CPU affinity, the variant and
# the responses. With --keep, the server stays up after a pass.
cmd_verify() {
    local variant="" keep=0 status=0 file
    local env_args=()
    local out=.local/verify

    while [ $# -gt 0 ]; do
        case "$1" in
            --keep) keep=1 ;;
            --env) env_args+=(--env "$2"); shift ;;
            -*) bench_die "unknown option: $1" ;;
            *) variant=$1 ;;
        esac
        shift
    done
    [ -n "$variant" ] || bench_die "missing variant"
    [ -f "variants/${variant}/variant.env" ] || bench_die "unknown variant: ${variant}"

    bench_trap_cleanup
    bench_port_free
    rm -rf "$out"
    mkdir -p "$out"

    bench_server_start "$variant" "${env_args[@]}"
    bench_server_wait
    bench_server_affinity "${out}/server-affinity.txt" || status=1
    if [ "$status" -eq 0 ]; then
        bench_verify_variant "$out" || status=1
    fi

    for file in server-affinity check verify-json verify-plaintext; do
        if [ -f "${out}/${file}.txt" ]; then
            echo "== ${file}"
            cat "${out}/${file}.txt"
        fi
    done

    [ "$status" -eq 0 ] || bench_die "verify failed"
    if [ "$keep" -eq 1 ]; then
        trap - EXIT
    fi
}

command=${1:-}
if [ $# -gt 0 ]; then
    shift
fi

case "$command" in
    build)
        build_target "$@"
        ;;
    lint)
        bench_tools vendor/bin/phpcs
        bench_tools vendor/bin/phpstan analyse --no-progress --memory-limit=1G
        ;;
    report)
        [ -n "${1:-}" ] || bench_die "usage: ./bench report <folder>"
        bench_tools php scripts/report.php "$1"
        ;;
    run)
        cmd_run "$@"
        ;;
    stop)
        bench_cleanup
        ;;
    sweep)
        cmd_sweep "$@"
        ;;
    test)
        bench_tools vendor/bin/phpunit "$@"
        ;;
    tools)
        bench_tools "$@"
        ;;
    verify)
        cmd_verify "$@"
        ;;
    wrk)
        cmd_wrk "$@"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
